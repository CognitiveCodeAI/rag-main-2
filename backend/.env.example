# =============================================================================
# NPR RAG Application - Environment Configuration Template
# =============================================================================
# Authoritative local template for backend/.env.
# Use ./dev init from repo root to create/sync backend/.env safely.
# Existing backend/.env values are preserved during sync.
#
# IMPORTANT: Never commit .env to version control!
#
# Values marked REQUIRED must be set. Others have safe defaults.
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Deployment profile. Local dev leaves this as "development".
# In "production" the app REFUSES TO START unless ACL is enabled and the
# database/MinIO credentials are not the insecure built-in defaults.
ENVIRONMENT=development
# DEBUG=true                     # Default is false; set true only for local debugging
# HOST=0.0.0.0
# PORT=8000

# CORS origins (comma-separated for multiple)
# CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================
# Defaults match docker-compose.yml settings for local development.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragdb
DB_USER=raguser
DB_PASSWORD=ragpass                 # REQUIRED: Change in production!

# Or use a full connection string (takes precedence over individual settings):
# DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/ragdb

# =============================================================================
# MILVUS VECTOR DATABASE
# =============================================================================
# Defaults match docker-compose.yml settings for local development.

MILVUS_HOST=localhost
MILVUS_PORT=19530

# =============================================================================
# MINIO OBJECT STORAGE
# =============================================================================
# Defaults match docker-compose.yml settings for local development.

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# MINIO_SECURE=false                # Set to true for HTTPS

# =============================================================================
# REDIS (for background tasks)
# =============================================================================
# Defaults match docker-compose.yml settings for local development.

REDIS_URL=redis://localhost:6379/0
REDIS_BACKEND=redis://localhost:6379/1

# =============================================================================
# OPENAI API (REQUIRED for embeddings)
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=your-openai-api-key-here  # REQUIRED - get from https://platform.openai.com/api-keys

# Embedding model configuration (optional - defaults shown)
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072

# =============================================================================
# LLM SETTINGS (for chat/QA)
# =============================================================================
# Default uses local Ollama for chat. OpenAI is used for embeddings.

# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# =============================================================================
# LLM QUERY REWRITING (OPTIONAL - for multi-turn chat)
# =============================================================================
# Enable for human chat interfaces to resolve pronouns/references.
# Disable for system/API integrations.

# ENABLE_LLM_QUERY_REWRITE=false
# LLM_REWRITE_MODEL=gpt-4o-mini
# LLM_REWRITE_TIMEOUT=5

# =============================================================================
# OCR SETTINGS (for scanned PDFs and image-based documents)
# =============================================================================
# OCR is used for documents with poor text extraction.
# Supports OpenAI (gpt-5-mini) or Ollama backends.

OCR_PROVIDER=openai                    # "openai" or "ollama"
OCR_OPENAI_MODEL=gpt-5-mini            # OpenAI vision model for OCR
# OCR_TIMEOUT=120                      # Timeout for full page OCR (seconds)
# OCR_REGION_TIMEOUT=60                # Timeout for region OCR (seconds)
# OCR_TEXT_LAYER_FALLBACK_ENABLED=false # OCR text-layer pages with low quality/short text
# OCR_TEXT_LAYER_MIN_CHARS=200          # Max native chars for text-layer OCR fallback

# Ollama OCR settings (if OCR_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_OCR_MODEL=deepseek-ocr:latest

# =============================================================================
# ACTIVE SYSTEM MONITOR (OPTIONAL)
# =============================================================================
# Optional supervisor for dev/staging reliability.
# Run via: ./dev monitor (foreground) or ./dev monitor --daemon (background)

# MONITOR_ENABLED=false
# MONITOR_MODE=observe                   # observe | heal
# MONITOR_DRY_RUN=false
# MONITOR_INTERVAL_SECONDS=15
# MONITOR_MAX_RETRIES=3
# MONITOR_BACKOFF_SECONDS=10
# MONITOR_CIRCUIT_BREAKER_THRESHOLD=5

# =============================================================================
# DOCUMENT PROCESSING
# =============================================================================
# TEXT_QUALITY_THRESHOLD=0.3      # Below this ratio, use OCR
# TARGET_CHUNK_TOKENS=500         # Target token count per chunk

# =============================================================================
# DOCLING INGESTION BACKEND (OPTIONAL - multi-format document conversion)
# =============================================================================
# Docling can handle PDF, DOCX, PPTX, XLSX, HTML, Markdown, CSV, and images.
# Requires: pip install docling>=2.72.0
# Note: First run downloads HuggingFace models (~1-2GB).
# Pre-download: docling-tools models download

# DOCLING_ENABLED_DEFAULT=false       # Enable Docling backend
# DOCLING_MODE=off                    # off | non_pdf_only | all
# DOCLING_MAX_PAGES=200               # Memory guard: max pages per document
# DOCLING_MAX_FILE_SIZE_MB=100        # Memory guard: max file size in MB
