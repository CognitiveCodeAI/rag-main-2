# =============================================================================
# NPR RAG Application - Environment Configuration Template
# =============================================================================
# Copy this file to .env and update values for your environment:
#   copy .env.example .env
#
# IMPORTANT: Never commit .env to version control!
#
# Values marked REQUIRED must be set. Others have safe defaults.
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# DEBUG=true                     # Default is true; set to false for production
# HOST=0.0.0.0
# PORT=8000

# CORS origins (comma-separated for multiple)
# CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================
# Defaults match docker-compose.yml settings for local development.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragdb
DB_USER=raguser
DB_PASSWORD=ragpass                 # REQUIRED: Change in production!

# Or use a full connection string (takes precedence over individual settings):
# DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/ragdb

# =============================================================================
# MILVUS VECTOR DATABASE
# =============================================================================
# Defaults match docker-compose.yml settings for local development.

MILVUS_HOST=localhost
MILVUS_PORT=19530

# =============================================================================
# MINIO OBJECT STORAGE
# =============================================================================
# Defaults match docker-compose.yml settings for local development.

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# MINIO_SECURE=false                # Set to true for HTTPS

# =============================================================================
# REDIS (for background tasks)
# =============================================================================
# Defaults match docker-compose.yml settings for local development.

REDIS_URL=redis://localhost:6379/0
REDIS_BACKEND=redis://localhost:6379/1

# =============================================================================
# OPENAI API (REQUIRED for embeddings)
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=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  # REQUIRED - get from https://platform.openai.com/api-keys

# Embedding model configuration (optional - defaults shown)
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072

# =============================================================================
# LLM SETTINGS (for chat/QA)
# =============================================================================
# Default uses local Ollama for chat. OpenAI is used for embeddings.

# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# =============================================================================
# LLM QUERY REWRITING (OPTIONAL - for multi-turn chat)
# =============================================================================
# Enable for human chat interfaces to resolve pronouns/references.
# Disable for system/API integrations.

# ENABLE_LLM_QUERY_REWRITE=false
# LLM_REWRITE_MODEL=gpt-4o-mini
# LLM_REWRITE_TIMEOUT=5

# =============================================================================
# OCR SETTINGS (OPTIONAL - for scanned PDFs)
# =============================================================================
# Ollama-based OCR for documents with poor text extraction.

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_OCR_MODEL=deepseek-ocr:latest
# OCR_TIMEOUT=120
# OCR_REGION_TIMEOUT=60
# OCR_MAX_RETRIES=3

# =============================================================================
# DOCUMENT PROCESSING
# =============================================================================
# TEXT_QUALITY_THRESHOLD=0.3      # Below this ratio, use OCR
# TARGET_CHUNK_TOKENS=500         # Target token count per chunk

# =============================================================================
# DOCLING INGESTION BACKEND (OPTIONAL - multi-format document conversion)
# =============================================================================
# Docling can handle PDF, DOCX, PPTX, XLSX, HTML, Markdown, CSV, and images.
# Requires: pip install docling>=2.72.0
# Note: First run downloads HuggingFace models (~1-2GB).
# Pre-download: docling-tools models download

# DOCLING_ENABLED_DEFAULT=false       # Enable Docling backend
# DOCLING_MODE=off                    # off | non_pdf_only | all
# DOCLING_MAX_PAGES=200               # Memory guard: max pages per document
# DOCLING_MAX_FILE_SIZE_MB=100        # Memory guard: max file size in MB
